[36m(main_task pid=3452925)[0m def binary_search(item: int, sorted_list: List[int]) -> bool:
[36m(main_task pid=3452925)[0m     """
[36m(main_task pid=3452925)[0m     Perform binary search on a sorted list to find an item.
[36m(main_task pid=3452925)[0m     
[36m(main_task pid=3452925)[0m     :param item: The item to search for.
[36m(main_task pid=3452925)[0m     :param sorted_list: The sorted list to search within.
[36m(main_task pid=3452925)[0m     :return: True if item is in the sorted_list, else False.
[36m(main_task pid=3452925)[0m     """
[36m(main_task pid=3452925)[0m     low = 0
[36m(main_task pid=3452925)[0m     high = len(sorted_list) - 1
[36m(main_task pid=3452925)[0m     while low <= high:
[36m(main_task pid=3452925)[0m         mid = (low + high) // 2
[36m(main_task pid=3452925)[0m         if sorted_list[mid] == item:
[36m(main_task pid=3452925)[0m             return True
[36m(main_task pid=3452925)[0m         elif sorted_list[mid] < item:
[36m(main_task pid=3452925)[0m             low = mid + 1
[36m(main_task pid=3452925)[0m         else:
[36m(main_task pid=3452925)[0m             high = mid - 1
[36m(main_task pid=3452925)[0m     return False
