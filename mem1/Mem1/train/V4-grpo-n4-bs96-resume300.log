[36m(main_task pid=3452925)[0m def union_of_sets(sets: List[List[int]]) -> List[int]:
[36m(main_task pid=3452925)[0m     """
[36m(main_task pid=3452925)[0m     Perform union of multiple sets.
[36m(main_task pid=3452925)[0m     
[36m(main_task pid=3452925)[0m     :param sets: List of lists where each sublist represents a set.
[36m(main_task pid=3452925)[0m     :return: A list representing the union of all the input sets.
[36m(main_task pid=3452925)[0m     """
