[36m(main_task pid=3452925)[0m def equal_length_lists(lists: List[List[int]]) -> Tuple[List[List[int]], bool]:
[36m(main_task pid=3452925)[0m     """
[36m(main_task pid=3452925)[0m     Check if all lists in the collection have equal length.
[36m(main_task pid=3452925)[0m     
[36m(main_task pid=3452925)[0m     :param lists: List of lists whose lengths are to be checked.
[36m(main_task pid=3452925)[0m     :return: A tuple with the lists and a boolean indicating if all lengths are equal.
[36m(main_task pid=3452925)[0m     """
[36m(main_task pid=3452925)[0m     all_equal = True
[36m(main_task pid=3452925)[0m     length = len(lists[0])
[36m(main_task pid=3452925)[0m     for lst in lists[1:]:
[36m(main_task pid=3452925)[0m         if len(lst) != length:
[36m(main_task pid=3452925)[0m             all_equal = False
[36m(main_task pid=3452925)[0m         length = len(lst)
[36m(main_task pid=3452925)[0m     return lists, all_equal
